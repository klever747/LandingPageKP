    {
      "parameters": {
        "operation": "executeQuery",
        "query": "-- Guarda la respuesta del asesor y apaga el bot para este cliente.\nWITH ins AS (\n  INSERT INTO public.messages (lead_id, phone, phone_number_id, sender, text, time, wa_message_id, msg_type)\n  VALUES ($1, $2, $5, 'asesor', $3, NOW(), NULLIF($4, ''), 'text')\n  ON CONFLICT (wa_message_id) DO NOTHING\n  RETURNING id\n), bot AS (\n  UPDATE public.leads SET bot_stage = 'asesor'\n  WHERE  id = $1 AND bot_stage IS DISTINCT FROM 'asesor'\n  RETURNING id\n)\nSELECT (SELECT id FROM ins) AS message_id, (SELECT count(*) FROM bot) AS bot_apagado;",
        "options": {
          "queryReplacement": "={{ [$('Buscar lead y ventana 24h').item.json.lead_id, $('Buscar lead y ventana 24h').item.json.phone, $('Validar datos').item.json.text, $json.messages?.[0]?.id ?? '', $('Buscar lead y ventana 24h').item.json.phone_number_id] }}"
        }
      },
