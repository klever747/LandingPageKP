    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Valida el cuerpo que envía el CRM. Dos formas:\n//   { \"lead_id\": 123, \"text\": \"...\" }                                   (recomendada)\n//   { \"phone\": \"5939...\", \"phone_number_id\": \"<línea de la agencia>\", \"text\": \"...\" }\n// La respuesta sale siempre por el número de la agencia dueña del lead.\nconst b = $json.body ?? {};\nconst lead_id = Number.parseInt(b.lead_id, 10) || 0;\nconst phone = String(b.phone ?? '').replace(/\\D/g, '');\nconst phone_number_id = String(b.phone_number_id ?? '').replace(/\\D/g, '');\nconst text = String(b.text ?? '').trim();\n\nlet error = '';\nif (!lead_id && !(phone.length >= 8 && phone.length <= 15 && phone_number_id))\n  error = 'Envía lead_id, o phone (formato internacional sin \"+\", ej. 593987654321) junto con phone_number_id';\nelse if (!text) error = 'text es obligatorio';\nelse if (text.length > 4096) error = 'text supera los 4096 caracteres que permite WhatsApp';\n\nreturn { json: { valido: !error, error, lead_id, phone, phone_number_id, text } };\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -416,
        0
      ],
      "id": "a1000000-0000-4000-8000-000000000002",
      "name": "Validar datos"
    },
    {
      "parameters": {
