    {
      "parameters": {
        "operation": "executeQuery",
        "query": "-- Busca el lead por id, o por (teléfono, línea). Siempre devuelve 1 fila.\nSELECT\n  l.id              AS lead_id,\n  l.phone           AS phone,\n  l.phone_number_id AS phone_number_id,\n  u.ultimo_cliente,\n  COALESCE(u.ultimo_cliente > NOW() - INTERVAL '24 hours', false) AS dentro_ventana\nFROM (SELECT NULLIF($1::int, 0) AS lead_id, $2::text AS phone, $3::text AS linea) p\nLEFT JOIN public.leads l\n       ON (p.lead_id IS NOT NULL AND l.id = p.lead_id)\n       OR (p.lead_id IS NULL AND l.phone = p.phone AND l.phone_number_id = p.linea)\nLEFT JOIN LATERAL (\n  SELECT MAX(m.time::timestamptz) AS ultimo_cliente\n  FROM   public.messages m\n  WHERE  m.lead_id = l.id AND m.sender = 'cliente'\n) u ON true;",
        "options": {
          "queryReplacement": "={{ [$json.lead_id, $json.phone, $json.phone_number_id] }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        32,
        -96
      ],
      "id": "a1000000-0000-4000-8000-000000000005",
